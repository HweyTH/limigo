{
  "title": "Limigo",
  "uid": "limigo",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by outcome",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (result) (rate(limigo_requests_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Request rate by node",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (instance) (rate(limigo_requests_total[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Fail-closed rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(limigo_requests_total{result=\"error\"}[5m]))",
          "legendFormat": "errors",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Redis round-trip latency percentiles",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(limigo_redis_latency_seconds_bucket[5m])) by (le, algorithm))",
          "legendFormat": "p50 {{algorithm}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(limigo_redis_latency_seconds_bucket[5m])) by (le, algorithm))",
          "legendFormat": "p95 {{algorithm}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(limigo_redis_latency_seconds_bucket[5m])) by (le, algorithm))",
          "legendFormat": "p99 {{algorithm}}",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Lua execution time percentiles",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(limigo_lua_execution_seconds_bucket[5m])) by (le, algorithm))",
          "legendFormat": "p50 {{algorithm}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(limigo_lua_execution_seconds_bucket[5m])) by (le, algorithm))",
          "legendFormat": "p95 {{algorithm}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(limigo_lua_execution_seconds_bucket[5m])) by (le, algorithm))",
          "legendFormat": "p99 {{algorithm}}",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Token bucket fill ratio per rule",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "limigo_token_bucket_fill_ratio",
          "legendFormat": "{{rule}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Config reload counter",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "increase(limigo_config_reload_total[1h])",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
